{
    // The repository's own conventions, applied on save, so that the CI formatting
    // gate is something the editor keeps you on the right side of rather than
    // something that fails your pull request.
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.formatOnSave": true,
    "editor.rulers": [100],

    // Trailing spaces are significant in Markdown, where two of them mean a line
    // break, so that one rule is switched back off.
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.tabSize": 4
    },

    // Pointing at the solution up front saves the pick-a-solution prompt on open.
    "dotnet.defaultSolution": "CostingTool.sln"
}

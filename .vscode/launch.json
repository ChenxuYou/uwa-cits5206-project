{
  // Press F5 to build the app and open it in a browser with the debugger attached.
  // Requires the "C# Dev Kit" extension — see .vscode/extensions.json.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the costing tool",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/bin/Debug/net10.0/CostingTool.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Attach to a running instance",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}

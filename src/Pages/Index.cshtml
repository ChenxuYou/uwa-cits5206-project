@page
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-wrap">
    <section class="page-heading">
        <div>
            <p class="eyebrow">SATURDAY, 15 AUGUST</p>
            <h1>Good morning, Priya</h1>
            <p>Here’s what’s happening across your research infrastructure.</p>
        </div>
        <a class="primary-button" href="/Ric/Start"><span>＋</span> Start new costing cycle</a>
    </section>

    <section class="summary-grid" aria-label="Costing summary">
        <article class="metric-card">
            <div class="metric-icon blue">◫</div>
            <div><span>Active cycles</span><strong>3</strong><small><b>2</b> require your attention</small></div>
        </article>
        <article class="metric-card">
            <div class="metric-icon violet">◇</div>
            <div><span>Total capabilities</span><strong>12</strong><small>Across 3 active platforms</small></div>
        </article>
        <article class="metric-card">
            <div class="metric-icon green">✓</div>
            <div><span>Sealed records</span><strong>8</strong><small><b class="positive">+2</b> this financial year</small></div>
        </article>
        <article class="metric-card">
            <div class="metric-icon amber">↗</div>
            <div><span>Cost recovery</span><strong>94.6%</strong><small><b class="positive">↑ 3.2%</b> from last cycle</small></div>
        </article>
    </section>

    <section class="dashboard-grid">
        <article class="panel progress-panel">
            <div class="panel-heading">
                <div><span class="status-pill draft">Draft</span><h2>Microscopy Platform</h2><p>2026–2029 costing cycle</p></div>
                <button class="more-button" aria-label="More options">•••</button>
            </div>
            <div class="progress-label"><span>Overall completion</span><strong>72%</strong></div>
            <div class="progress-track"><span style="width:72%"></span></div>

            <div class="steps">
                <div class="step complete"><span>✓</span><div><strong>Platform details</strong><small>Completed 12 Aug</small></div></div>
                <div class="step complete"><span>✓</span><div><strong>Operating costs</strong><small>Completed 13 Aug</small></div></div>
                <div class="step current"><span>3</span><div><strong>Capacity &amp; utilisation</strong><small>2 capabilities need forecasts</small></div></div>
                <div class="step"><span>4</span><div><strong>Review sustainable rates</strong><small>Not started</small></div></div>
                <div class="step"><span>5</span><div><strong>Propose &amp; seal</strong><small>Not started</small></div></div>
            </div>

            <a class="continue-button" href="#continue">Continue cycle <span>→</span></a>
        </article>

        <article class="panel financial-panel">
            <div class="panel-heading compact">
                <div><h2>Financial overview</h2><p>Microscopy Platform · 2026–27 forecast</p></div>
                <button class="outline-button">View details</button>
            </div>
            <div class="financial-summary">
                <div><span>Total operating cost</span><strong>$684,250</strong></div>
                <div><span>Non-variable income</span><strong>− $124,000</strong></div>
                <div class="recover"><span>Amount to recover</span><strong>$560,250</strong></div>
            </div>
            <div class="recovery-heading"><span>Projected cost recovery</span><strong>94.6%</strong></div>
            <div class="recovery-bar"><span class="recovered"></span><span class="gap"></span></div>
            <div class="legend"><span><i class="legend-dot navy"></i>Projected revenue <b>$530,000</b></span><span><i class="legend-dot pale"></i>Funding gap <b>$30,250</b></span></div>
            <div class="callout"><span>i</span><p><strong>A $30,250 funding gap remains.</strong><br>Review proposed rates or forecast utilisation before sealing.</p></div>
        </article>
    </section>

    <section class="panel rate-panel" id="capabilities">
        <div class="panel-heading compact">
            <div><h2>Capability rate summary</h2><p>Minimum sustainable charge-out rates by user category</p></div>
            <a class="text-link" href="#all-capabilities">View all capabilities →</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Capability</th><th>Forecast use</th><th>UWA researcher</th><th>APFR</th><th>External / industry</th><th>Status</th></tr></thead>
                <tbody>
                    <tr><td><span class="capability-icon">EM</span><strong>Electron Microscopy</strong><small>Billable unit: hour</small></td><td><strong>1,120 hrs</strong><small>64.9% of capacity</small></td><td>$186.40</td><td>$224.80</td><td>$268.10</td><td><span class="status-pill ready">Ready</span></td></tr>
                    <tr><td><span class="capability-icon purple">CM</span><strong>Confocal Microscopy</strong><small>Billable unit: hour</small></td><td><strong>860 hrs</strong><small>49.9% of capacity</small></td><td>$142.20</td><td>$174.60</td><td>$211.30</td><td><span class="status-pill ready">Ready</span></td></tr>
                    <tr><td><span class="capability-icon orange">MP</span><strong>Materials Preparation</strong><small>Billable unit: sample</small></td><td><strong>—</strong><small>Forecast required</small></td><td>—</td><td>—</td><td>—</td><td><span class="status-pill action">Action needed</span></td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="bottom-grid" id="cycles">
        <article class="panel recent-panel">
            <div class="panel-heading compact"><div><h2>Recent costing cycles</h2><p>Your latest records and drafts</p></div><a class="text-link" href="#all-cycles">View all →</a></div>
            <div class="cycle-row"><span class="record-icon">▤</span><div><strong>Microscopy Platform</strong><small>2026–2029 · Last edited 2 hours ago</small></div><span class="status-pill draft">Draft</span><strong>72%</strong><span>→</span></div>
            <div class="cycle-row"><span class="record-icon sealed">✓</span><div><strong>Marine Research Facility</strong><small>2025–2028 · Sealed 4 Jun 2026</small></div><span class="status-pill sealed">Sealed</span><strong>100%</strong><span>→</span></div>
            <div class="cycle-row"><span class="record-icon sealed">✓</span><div><strong>Human MRI Facility</strong><small>2025–2027 · Sealed 19 Nov 2025</small></div><span class="status-pill sealed">Sealed</span><strong>100%</strong><span>→</span></div>
        </article>

        <article class="panel deadline-panel">
            <div class="panel-heading compact"><div><h2>Upcoming deadlines</h2><p>Items requiring attention</p></div></div>
            <div class="deadline-row"><span class="date-box"><b>28</b>AUG</span><div><strong>Complete utilisation forecast</strong><small>Microscopy Platform</small></div><span class="urgent">13 days</span></div>
            <div class="deadline-row"><span class="date-box"><b>15</b>SEP</span><div><strong>Submit rates for review</strong><small>Microscopy Platform</small></div><span>31 days</span></div>
            <div class="deadline-row"><span class="date-box"><b>01</b>OCT</span><div><strong>New rates take effect</strong><small>Marine Research Facility</small></div><span>47 days</span></div>
        </article>
    </section>
</div>

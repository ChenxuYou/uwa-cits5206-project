@page
@model CostingTool.Pages.IndexModel
@using CostingTool.Pages.Ric
@{
    ViewData["Title"] = "My costing cycles";
    string Label(string status) => status switch { "Sealed" => "Approved", "Returned" => "Returned · changes required", "Submitted" => "Submitted for approval", _ => "Draft" };
}
<div class="page-wrap">
    <section class="page-heading"><div><p class="eyebrow">PLATFORM CUSTODIAN WORKSPACE</p><h1>Welcome, @User.Identity?.Name</h1><p>Create costing cycles and track every submission decision.</p></div><a class="primary-button" asp-page="/Ric/Start"><span>＋</span> Start new costing cycle</a></section>
    <section class="summary-grid">
        <article class="metric-card"><div class="metric-icon blue">◫</div><div><span>All cycles</span><strong>@Model.Cycles.Count</strong><small>Your costing records</small></div></article>
        <article class="metric-card"><div class="metric-icon amber">↗</div><div><span>Awaiting approval</span><strong>@Model.Cycles.Count(x=>x.Status=="Submitted")</strong><small>Currently locked</small></div></article>
        <article class="metric-card"><div class="metric-icon green">✓</div><div><span>Approved</span><strong>@Model.Cycles.Count(x=>x.Status=="Sealed")</strong><small>Sealed records</small></div></article>
        <article class="metric-card"><div class="metric-icon violet">!</div><div><span>Unread notifications</span><strong>@Model.UnreadCount</strong><small>Approval decisions</small></div></article>
    </section>
    <div class="my-work-grid">
        <article class="panel cycle-list-panel"><div class="panel-heading compact"><div><h2>My costing cycles</h2><p>Drafts, submitted records and decisions.</p></div></div>
        @if(Model.Cycles.Count==0){<div class="empty-state">You have not created a costing cycle yet.</div>}
        @foreach(var cycle in Model.Cycles)
        {
            @* US-02: a draft reopens at the step it was left on; anything else opens at its review. *@
            var step = RicSteps.Get(cycle.IsEditable ? cycle.LastStep : RicSteps.Review);
            var superseded = Model.Superseded.Contains(cycle.Id);
            var replaces = cycle.SupersedesCycleId is { } replacedId ? Model.Cycles.FirstOrDefault(x => x.Id == replacedId) : null;
            <a id="cycle-@cycle.Id" class="my-cycle-row" asp-page="@step.Page" asp-route-cycleId="@cycle.Id">
                <span class="record-icon @(cycle.Status=="Sealed"?"sealed":"")">◫</span>
                <div>
                    <strong>@cycle.PlatformName</strong>
                    <small>@cycle.StartYear–@cycle.EndYear · @cycle.Capabilities.Count capabilities@(replaces is null ? "" : $" · replaces the {replaces.StartYear}–{replaces.EndYear} record")</small>
                    <small>
                        @if (string.IsNullOrEmpty(cycle.LastEditedByDisplay))
                        {
                            <text>Updated @cycle.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</text>
                        }
                        else
                        {
                            <text>Last edited @cycle.LastEditedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") by @cycle.LastEditedByDisplay</text>
                        }
                        @if (cycle.IsEditable)
                        {
                            <text> · left at @step.Name</text>
                        }
                    </small>
                </div>
                <span class="status-pill @(superseded ? "superseded" : cycle.Status.ToLowerInvariant())">@(superseded ? "Superseded" : Label(cycle.Status))</span>
                <b>@(cycle.IsEditable ? "Resume →" : "Open →")</b>
            </a>
        }
        </article>
        <aside class="panel notification-preview"><div class="panel-heading compact"><div><h2>Notifications</h2><p>Approval activity</p></div><a class="text-link" asp-page="/Notifications/Index">View all</a></div>
        @if(Model.RecentNotifications.Count==0){<div class="empty-state">No notifications yet.</div>}
        @foreach(var notice in Model.RecentNotifications){<a class="notice-preview-row @(notice.IsRead?"":"unread")" asp-page="/Notifications/Index"><span class="notice-dot"></span><div><strong>@notice.Title</strong><small>@notice.CreatedAtUtc.ToLocalTime().ToString("dd MMM, h:mm tt")</small></div></a>}
        </aside>
    </div>
</div>

@page
@model CostingTool.Pages.Notifications.IndexModel
@{ViewData["Title"]="Notifications";}
<div class="page-wrap notification-page"><div class="page-heading"><div><p class="eyebrow">ACTIVITY INBOX</p><h1>Notifications</h1><p>Approval and return decisions for your costing cycles.</p></div>@if(Model.Notifications.Any(x=>!x.IsRead)){<form method="post" asp-page-handler="ReadAll"><button class="outline-button" type="submit">Mark all as read</button></form>}</div>
<article class="panel notification-list">@if(Model.Notifications.Count==0){<div class="empty-state">You have no notifications.</div>}@foreach(var n in Model.Notifications){<form method="post" asp-page-handler="Read" class="notification-row @(n.IsRead?"":"unread")"><input type="hidden" name="id" value="@n.Id"><span class="notification-symbol @n.Type.ToLowerInvariant()">@(n.Type=="Approved"?"✓":"↩")</span><div><strong>@n.Title</strong><p>@n.Message</p><small>@n.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</small></div><button type="submit">Open record →</button></form>}</article></div>

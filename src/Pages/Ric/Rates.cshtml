@page
@model CostingTool.Pages.Ric.RatesModel
@using System.Globalization
@using CostingTool.Models
@using CostingTool.Pdf
@{
    ViewData["Title"] = "Sustainable rates";

    // The uplift is versioned configuration, so the label reads it rather than stating a
    // number. The page used to say "Includes 35% indirect cost" in fixed text, which would
    // have gone quietly wrong the first time k changed.
    var k = Model.Rates.Method.IndirectCostRecovery;
    var upliftLabel = $"Includes {(k - 1m) * 100m:0.#}% indirect cost recovery";
    var unit = Model.Cycle.BillableUnit.ToLowerInvariant();
    var perUnit = Model.Cycle.BillableUnit.TrimEnd('s').ToLowerInvariant();

    // A proposed rate of zero means "not entered yet" (the model stores decimals, not nulls,
    // and submission refuses a zero rate). Until one is entered the page says so, rather than
    // showing a deficit equal to the whole operating cost.
    var anyProposed = Model.Rates.All.Any(x =>
        x.ProposedUwaRate > 0 || x.ProposedApfrRate > 0 || x.ProposedCommercialRate > 0);

    // The balance is written the way the sealed PDF writes it (RecordFormat.Balance): the word
    // and the brackets carry the meaning, never colour alone. Rounded first, so a figure that
    // shows as $0.00 is never called a deficit.
    var platformBalance = Model.Rates.Round(Model.Rates.ForecastBalance);
}

<div class="page-wrap ric-page">
    <partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(5, Model.Cycle.Id)' />

    <div class="ric-title">
        <div>
            <span class="eyebrow">@Model.Cycle.PlatformName.ToUpper()</span>
            <h1>Sustainable and proposed rates</h1>
            <p>Every rate on this page is @RateCategories.GstLabel, per @perUnit.</p>
        </div>
        <div class="ric-total">
            <small>Method version</small>
            <strong>@Model.Rates.Method.Version</strong>
        </div>
    </div>

    @* The form names its own action. Without one it posts back to the address the page was
       rendered at, and after "Update balance" (or a refused "Save and go back") that address
       carries ?handler=Preview or ?handler=Back — so "Review costing cycle" would run that
       handler again instead of saving. The two other buttons set their own formaction. *@
    @* data-save-on-leave: a link followed with unsaved figures saves them first (US-02). If
       that save was refused, the page says why and the next link falls back to the warning,
       so a custodian who wants to leave is never held here. *@
    <form method="post" asp-page="/Ric/Rates" asp-route-cycleId="@Model.Cycle.Id" data-unsaved-warning data-save-on-leave="@(string.IsNullOrEmpty(Model.LeavingFor) ? "true" : "false")">
        <input type="hidden" asp-for="CycleId" />
        <input type="hidden" name="LeavingFor" value="" />
        @if (!string.IsNullOrEmpty(Model.LeavingFor))
        {
            <p class="form-errors">Your changes could not be saved on the way out, so this page is still open. Correct the problems below, or follow the link again to leave without saving them.</p>
        }
        <div asp-validation-summary="All" class="form-errors"></div>

        <section class="ric-card">
            <div class="ric-card-title">
                <h2>How to read these rates</h2>
                <p>@RateCategories.ProposedRateFraming</p>
            </div>
            <p><small>@RateCategories.UpliftExplanation</small></p>
        </section>

        @if (Model.Previous is not null)
        {
            <partial name="_PreviousRecord" model="Model.Previous" />
        }

        <div class="rate-list">
            @for (var i = 0; i < Model.Inputs.Count; i++)
            {
                var capability = Model.Cycle.Capabilities.First(x => x.Id == Model.Inputs[i].Id);
                var rates = Model.Rates.For(capability.Id);

                <article class="ric-card rate-card">
                    <input type="hidden" asp-for="Inputs[i].Id" />

                    <div class="rate-card-head">
                        <div>
                            <h2>@capability.Name</h2>
                            @if (rates is null)
                            {
                                <p>Not yet priced.</p>
                            }
                            else
                            {
                                <p>
                                    Operating cost @rates.TotalOperatingCost.ToString("C")
                                    · less funding @rates.TotalIncome.ToString("C")
                                    · forecast use @rates.ForecastUtilisation.ToString("N1") @unit
                                </p>
                            }
                        </div>
                    </div>

                    @if (rates is null)
                    {
                        @* Rule R4: the engine refuses rather than returning a plausible zero,
                           and the refusal is shown where the number would have been. *@
                        <div class="callout">
                            <span>!</span>
                            <div>
                                <strong>No rate can be calculated yet</strong>
                                <p>@Model.Rates.ProblemFor(capability.Id)</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        // data-calculated carries the number the page already shows, so the
                        // browser can work out the variance as the custodian types. It is
                        // culture-invariant because a script reads it.
                        var uwaCalculated = rates.DisplayUwaRate.ToString(CultureInfo.InvariantCulture);
                        var apfrCalculated = rates.DisplayApfrRate.ToString(CultureInfo.InvariantCulture);
                        var commercialCalculated = rates.DisplayCommercialRate.ToString(CultureInfo.InvariantCulture);

                        var proposedCount = new[] { rates.ProposedUwaRate, rates.ProposedApfrRate, rates.ProposedCommercialRate }.Count(x => x > 0);
                        var balance = rates.Round(rates.ForecastBalance);

                        <div class="rate-grid">
                            <div class="rate-column" data-kind="uwa" data-calculated="@uwaCalculated">
                                <span>@RateCategories.UwaResearcher.Name</span>
                                <small>Minimum sustainable · @RateCategories.GstLabel</small>
                                <strong>@rates.DisplayUwaRate.ToString("C")</strong>
                                <small>@RateCategories.UwaResearcher.Eligibility</small>
                                <small>@RateCategories.UwaResearcher.IncomeDeducted</small>
                                <small>No indirect cost recovery is added to this rate.</small>
                                <label>
                                    Proposed rate
                                    <input asp-for="Inputs[i].Uwa" type="number" min="0" step="0.01" aria-describedby="variance-@(i)-uwa" />
                                </label>
                                <p class="rate-variance" id="variance-@(i)-uwa">@RateVariance.Describe(rates.DisplayUwaRate, rates.ProposedUwaRate)</p>
                            </div>
                            <div class="rate-column" data-kind="apfr" data-calculated="@apfrCalculated">
                                <span>@RateCategories.Apfr.Name</span>
                                <small>@upliftLabel · @RateCategories.GstLabel</small>
                                <strong>@rates.DisplayApfrRate.ToString("C")</strong>
                                <small>@RateCategories.Apfr.Eligibility</small>
                                <small>@RateCategories.Apfr.IncomeDeducted</small>
                                <label>
                                    Proposed rate
                                    <input asp-for="Inputs[i].Apfr" type="number" min="0" step="0.01" aria-describedby="variance-@(i)-apfr" />
                                </label>
                                <p class="rate-variance" id="variance-@(i)-apfr">@RateVariance.Describe(rates.DisplayApfrRate, rates.ProposedApfrRate)</p>
                            </div>
                            <div class="rate-column" data-kind="commercial" data-calculated="@commercialCalculated">
                                <span>@RateCategories.Commercial.Name</span>
                                <small>@upliftLabel · @RateCategories.GstLabel</small>
                                <strong>@rates.DisplayCommercialRate.ToString("C")</strong>
                                <small>@RateCategories.Commercial.Eligibility</small>
                                <small>@RateCategories.Commercial.IncomeDeducted</small>
                                <label>
                                    Proposed rate
                                    <input asp-for="Inputs[i].Commercial" type="number" min="0" step="0.01" aria-describedby="variance-@(i)-commercial" />
                                </label>
                                <p class="rate-variance" id="variance-@(i)-commercial">@RateVariance.Describe(rates.DisplayCommercialRate, rates.ProposedCommercialRate)</p>
                            </div>
                        </div>

                        @* US-11: where a commercial rate is varied, the University's competitive
                           neutrality obligations are surfaced, in the guide's words [G, Step 3].
                           Rendered on every card and shown or hidden by the script below as the
                           custodian types, with the same test the server uses
                           (CommercialRateVaries) for the first render. *@
                        <div class="callout commercial-note" role="note" hidden="@(rates.CommercialRateVaries ? null : "hidden")">
                            <span aria-hidden="true">!</span>
                            <div>
                                <strong>Competitive neutrality</strong>
                                <p>@RateCategories.CompetitiveNeutrality</p>
                            </div>
                        </div>

                        <details class="rate-workings">
                            <summary>The figures behind these rates</summary>
                            <div class="review-table-wrap">
                                <table class="review-table">
                                    <tbody>
                                        <tr><td>Operating cost booked to this capability</td><td>@rates.CapabilityOperatingCost.ToString("C")</td></tr>
                                        <tr><td>Share of platform-level cost</td><td>@rates.AllocatedPlatformCost.ToString("C")</td></tr>
                                        <tr><td><strong>Total operating cost</strong></td><td><strong>@rates.TotalOperatingCost.ToString("C")</strong></td></tr>
                                        <tr><td>Less UWA non-variable income</td><td>−@rates.UwaIncome.ToString("C")</td></tr>
                                        <tr><td>Less non-UWA non-variable income</td><td>−@rates.NonUwaIncome.ToString("C")</td></tr>
                                        <tr><td><strong>Cost to recover from usage</strong></td><td><strong>@rates.NetCostToRecover.ToString("C")</strong></td></tr>
                                        <tr>
                                            <td>Forecast utilisation — the divisor</td>
                                            <td>
                                                @rates.ForecastUtilisation.ToString("N1") @unit
                                                (UWA @rates.ForecastUwaUse.ToString("N1") ·
                                                APFR @rates.ForecastApfrUse.ToString("N1") ·
                                                commercial @rates.ForecastCommercialUse.ToString("N1"))
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </details>

                        @if (proposedCount == 0)
                        {
                            <div class="rate-balance">
                                <span>Forecast balance at proposed rates</span>
                                <small>Enter proposed rates to see the effect.</small>
                            </div>
                        }
                        else
                        {
                            <div class="cost-summary">
                                <span><em>Billed to users at the proposed rates</em><b>@rates.GrossForecastRevenue.ToString("C")</b></span>
                                <span><em>Less University overheads recovered<small>@upliftLabel</small></em><b>−@rates.OverheadsRecovered.ToString("C")</b></span>
                                <span><em>Retained by the platform</em><b>@rates.ForecastRevenue.ToString("C")</b></span>
                                <span><em>Cost to recover from usage</em><b>@rates.NetCostToRecover.ToString("C")</b></span>
                                <span class="@(balance >= 0 ? "positive-text" : "negative-text")">
                                    <em>Forecast balance<small>Against full economic cost: @RecordFormat.Balance(rates.Round(rates.FullEconomicCostBalance))</small></em>
                                    <b>@RecordFormat.Balance(balance)</b>
                                </span>
                            </div>
                            @if (proposedCount < 3)
                            {
                                <p class="rate-effect-note">Not all three proposed rates are entered, so this understates revenue.</p>
                            }
                        }
                    }
                </article>
            }
        </div>

        <section class="ric-card rate-effect" aria-labelledby="rate-effect-heading">
            <h2 id="rate-effect-heading">The platform at the proposed rates</h2>
            <p class="rate-effect-note">Summed over every capability that priced — never a stored total.</p>

            @if (Model.IsPreview)
            {
                <div class="callout" role="status">
                    <span aria-hidden="true">i</span>
                    <div>
                        <strong>Balance updated</strong>
                        <p>These figures use the rates you have typed. They are not saved until you continue to the review or go back a step.</p>
                    </div>
                </div>
            }

            @if (!anyProposed)
            {
                <p class="rate-effect-note">Enter proposed rates to see the forecast surplus or deficit they produce.</p>
            }
            else
            {
                <div class="cost-summary">
                    <span><em>Total operating cost</em><b>@Model.Rates.TotalOperatingCost.ToString("C")</b></span>
                    <span><em>Less non-variable income</em><b>−@Model.Rates.TotalIncome.ToString("C")</b></span>
                    <span><em>Cost to recover from usage</em><b>@Model.Rates.NetCostToRecover.ToString("C")</b></span>
                    <span><em>Retained revenue at the proposed rates<small>University overheads recovered: @Model.Rates.OverheadsRecovered.ToString("C")</small></em><b>@Model.Rates.ForecastRevenue.ToString("C")</b></span>
                    <span class="@(platformBalance >= 0 ? "positive-text" : "negative-text")">
                        <em>Forecast balance<small>Against full economic cost: @RecordFormat.Balance(Model.Rates.Round(Model.Rates.FullEconomicCostBalance))</small></em>
                        <b>@RecordFormat.Balance(platformBalance)</b>
                    </span>
                </div>
                @if (!Model.Rates.IsComplete)
                {
                    <p class="rate-effect-note">Capabilities that could not be priced are not in these totals.</p>
                }
            }

            <div class="rate-effect-actions">
                @* Enter in a rate box submits the first button in the form, so it previews the
                   balance rather than saving or going back. Nothing is lost by that; saving is
                   the button at the bottom. *@
                <button type="submit" class="outline-button" asp-page-handler="Preview" asp-route-cycleId="@Model.Cycle.Id">Update balance</button>
                <span>Change a proposed rate, then update the balance to see its effect. Nothing is saved until you continue or go back.</span>
            </div>
        </section>

        <section class="ric-card rate-notes">
            <div class="form-grid two-columns">
                <label class="field">
                    <span>Benchmarking notes</span>
                    <textarea asp-for="BenchmarkNotes" rows="5" placeholder="Comparable facilities, published rates and differences in value..."></textarea>
                </label>
                <label class="field">
                    <span>Pricing justification</span>
                    <textarea asp-for="PricingJustification" rows="5" placeholder="Explain why the proposed rates differ from the calculated minimums, and how a forecast deficit will be carried."></textarea>
                    <span asp-validation-for="PricingJustification" class="field-error"></span>
                </label>
            </div>
        </section>

        <div class="wizard-actions">
            @* A link here would have thrown away everything typed on this screen — US-10. *@
            <button class="secondary-action" type="submit" asp-page-handler="Back">← Save and go back to capacity</button>
            <button class="primary-button" type="submit">Review costing cycle →</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Live variance as the custodian types. This repeats the sentence RateVariance.Describe
        // writes on the server, using only numbers already on the page (data-calculated and the
        // typed value); no formula or coefficient is involved. Whole cents throughout, so
        // 50.00 - 36.64 is 13.36 and not 13.360000000000003.
        (function () {
            var money = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' });

            // The number inputs are followed by a hidden __Invariant field that ASP.NET adds, so the
        // script asks for the number input by type.
        function cents(value) {
                return Math.round((Number(value) || 0) * 100);
            }

            function describe(calculated, typed) {
                if (!(Number(typed) > 0)) {
                    return 'Enter a proposed rate to compare with the calculated rate.';
                }
                var diff = cents(typed) - cents(calculated);
                if (diff === 0) {
                    return 'Matches the calculated rate.';
                }
                var text = money.format(Math.abs(diff) / 100);
                if (cents(calculated) !== 0) {
                    text += ' (' + (Math.abs(diff) / Math.abs(cents(calculated)) * 100).toFixed(1) + '%)';
                }
                return text + (diff > 0 ? ' above' : ' below') + ' the calculated rate.';
            }

            function showsNote(column) {
                var typed = column.querySelector('input[type="number"]').value;
                return Number(typed) > 0 && cents(typed) !== cents(column.dataset.calculated);
            }

            document.querySelectorAll('.rate-card').forEach(function (card) {
                var note = card.querySelector('.commercial-note');
                var commercial = card.querySelector('.rate-column[data-kind="commercial"]');

                function refresh(column) {
                    var input = column.querySelector('input[type="number"]');
                    var output = column.querySelector('.rate-variance');
                    if (input && output) {
                        output.textContent = describe(column.dataset.calculated, input.value);
                    }
                    if (note && commercial) {
                        note.hidden = !showsNote(commercial);
                    }
                }

                card.querySelectorAll('.rate-column[data-calculated]').forEach(function (column) {
                    var input = column.querySelector('input[type="number"]');
                    if (input) {
                        input.addEventListener('input', function () { refresh(column); });
                    }
                    refresh(column);
                });
            });
        })();
    </script>
}

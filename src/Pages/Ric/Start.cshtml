@page
@model CostingTool.Pages.Ric.StartModel
@{
    ViewData["Title"] = Model.IsEditing ? "Platform and capabilities" : "Start RIC cycle";
    var hasCostLines = Model.IsEditing && Model.Cycle.Costs.Count > 0;
}
<div class="page-wrap ric-page">
    @if (Model.IsEditing)
    {
        <nav class="breadcrumb"><a href="/">Overview</a><span>›</span><span>@Model.Cycle.PlatformName</span><span>›</span><span>Platform and capabilities</span></nav>
    }
    else
    {
        <nav class="breadcrumb"><a href="/">Overview</a><span>›</span><span>New RIC costing cycle</span></nav>
    }
    <partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(1, Model.CycleId)' />
    <form method="post" asp-page="/Ric/Start" asp-route-cycleId="@Model.CycleId" class="ric-card narrow-card" data-unsaved-warning>
        <input type="hidden" asp-for="CycleId" />
        <div class="ric-heading"><span>01</span><div><h1>Platform and capabilities</h1><p>Define the infrastructure being costed and the unit users are charged in.</p></div></div>
        <div asp-validation-summary="All" class="form-errors"></div>
        <div class="form-grid two-columns">
            <label class="field full-span"><span>Platform name <b>*</b></span><input asp-for="PlatformName" placeholder="e.g. Cytometry"></label>
            <label class="field"><span>Pricing period starts <b>*</b></span><input asp-for="StartYear" type="number" min="2020" max="2200"></label>
            <label class="field">
                <span>Pricing period ends <b>*</b></span><input asp-for="EndYear" type="number" min="2020" max="2200">
                @if (hasCostLines)
                {
                    <small>Cost and funding lines hold an amount for each year, so the period can move but not change length.</small>
                }
            </label>
            <label class="field full-span">
                <span>Billable unit <b>*</b></span>
                <select asp-for="BillableUnit">
                    @foreach (var unit in CostingTool.Pages.Ric.StartModel.BillableUnits)
                    {
                        <option>@unit</option>
                    }
                </select>
                <small>This unit must stay consistent across capacity, utilisation and rates@(Model.IsEditing ? ": changing it clears the capacity, forecasts and proposed rates already entered." : ".")</small>
            </label>

            @if (Model.IsEditing)
            {
                <fieldset class="field full-span capability-edit">
                    <legend>Capabilities <b>*</b></legend>
                    <small>Rename a capability here. Removing one also removes the cost lines booked to it and its capacity.</small>
                    @for (var i = 0; i < Model.Existing.Count; i++)
                    {
                        <div class="capability-edit-row">
                            <input type="hidden" asp-for="Existing[i].Id" />
                            <input asp-for="Existing[i].Name" aria-label="Capability @(i + 1) name" />
                            <label><input type="checkbox" asp-for="Existing[i].Remove" /> Remove</label>
                        </div>
                    }
                </fieldset>
                <label class="field full-span"><span>Add capabilities</span><textarea asp-for="CapabilityNames" rows="3" placeholder="One new capability per line"></textarea><small>A new capability starts with no costs or capacity, and takes an equal share of every platform-level cost.</small></label>
            }
            else
            {
                <label class="field full-span"><span>Capabilities <b>*</b></span><textarea asp-for="CapabilityNames" rows="5" placeholder="Enter one capability per line, e.g.&#10;Flow Cytometry&#10;Cell Sorting&#10;Analysis / Consulting"></textarea><small>You can also separate names with commas.</small></label>
            }
        </div>

        @if (Model.NeedsRemovalConfirmation)
        {
            <label class="confirmation"><input type="checkbox" name="ConfirmRemovals" value="true"><span>Remove these capabilities and everything entered against them.</span></label>
        }
        @if (Model.NeedsUnitChangeConfirmation)
        {
            <label class="confirmation"><input type="checkbox" name="ConfirmUnitChange" value="true"><span>Change the unit and clear capacity, forecast use and proposed rates.</span></label>
        }

        @if (Model.IsEditing)
        {
            <div class="wizard-actions"><a class="secondary-action" asp-page="/Ric/Costs" asp-route-cycleId="@Model.CycleId">Cancel</a><button class="primary-button" type="submit">Save and continue to costs →</button></div>
        }
        else
        {
            <div class="wizard-actions"><a href="/" class="secondary-action">Cancel</a><button class="primary-button" type="submit">Continue to costs →</button></div>
        }
    </form>
</div>

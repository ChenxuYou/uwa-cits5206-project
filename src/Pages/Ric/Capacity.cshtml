@page
@model CostingTool.Pages.Ric.CapacityModel
@{ViewData["Title"]="Capacity and utilisation";}
<div class="page-wrap ric-page"><partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(3, Model.Cycle.Id)' />
<div class="ric-title"><div><span class="eyebrow">@Model.Cycle.PlatformName.ToUpper()</span><h1>Capacity and forecast utilisation</h1><p>Enter realistic annual figures in @Model.Cycle.BillableUnit.ToLower(). Rates use forecast utilisation—not maximum capacity.</p></div></div>
<form method="post" class="ric-card"><input type="hidden" asp-for="CycleId"><div asp-validation-summary="All" class="form-errors"></div>
<div class="capacity-note"><b>Reference baseline</b><span>Staff availability: 230 days × 7.5 hours = 1,725 hours. Adjust for maintenance, downtime, staff availability and planned outages.</span></div>
<div class="capacity-list">@for(var i=0;i<Model.Inputs.Count;i++){var c=Model.Cycle.Capabilities.First(x=>x.Id==Model.Inputs[i].Id);<section class="capacity-card"><input type="hidden" asp-for="Inputs[i].Id"><div class="capacity-name"><span>@(i+1)</span><div><h2>@c.Name</h2><p>Annual figures · @Model.Cycle.BillableUnit</p></div><strong class="utilisation-display" data-index="@i">0%</strong></div><div class="form-grid capacity-grid"><label class="field"><span>Maximum capacity</span><input asp-for="Inputs[i].MaximumCapacity" class="capacity-value" data-index="@i" type="number" min="0" step="0.01"></label><label class="field"><span>UWA forecast use</span><input asp-for="Inputs[i].UwaUse" class="use-value" data-index="@i" type="number" min="0" step="0.01"></label><label class="field"><span>APFR forecast use</span><input asp-for="Inputs[i].ApfrUse" class="use-value" data-index="@i" type="number" min="0" step="0.01"></label><label class="field"><span>Commercial forecast use</span><input asp-for="Inputs[i].CommercialUse" class="use-value" data-index="@i" type="number" min="0" step="0.01"></label></div></section>}</div>
<div class="wizard-actions"><a class="secondary-action" asp-page="/Ric/Costs" asp-route-cycleId="@Model.Cycle.Id">← Back to costs</a><button class="primary-button" type="submit">Calculate rates →</button></div></form></div>
@section Scripts{<script>function calc(i){const cap=Number(document.querySelector(`.capacity-value[data-index="${i}"]`).value)||0;const use=[...document.querySelectorAll(`.use-value[data-index="${i}"]`)].reduce((s,x)=>s+(Number(x.value)||0),0);document.querySelector(`.utilisation-display[data-index="${i}"]`).textContent=cap?`${(use/cap*100).toFixed(1)}%`:'0%';}document.querySelectorAll('.capacity-value,.use-value').forEach(x=>{x.oninput=()=>calc(x.dataset.index);calc(x.dataset.index)});</script>}

@page
@model CostingTool.Pages.Ric.ReviewModel
@{ViewData["Title"]="Review RIC cycle";var totalCost=Model.Results.Values.Sum(x=>x.TotalOperatingCost);var revenue=Model.Results.Values.Sum(x=>x.ForecastPlatformRevenue);}
<div class="page-wrap ric-page"><partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(5, Model.Cycle.Id)' />
@if(Model.SuccessMessage is not null){<div class="submit-success"><span>✓</span><div><strong>Submitted successfully</strong><p>@Model.SuccessMessage</p></div></div>}
<div class="ric-title"><div><span class="status-pill @(Model.Submitted?"sealed":"draft")">@Model.Cycle.Status</span><h1>Review costing cycle</h1><p>@Model.Cycle.PlatformName · @Model.Cycle.StartYear–@Model.Cycle.EndYear · per @Model.Cycle.BillableUnit.TrimEnd('s').ToLower()</p></div>@if(!Model.Submitted){<a class="outline-action" asp-page="/Ric/Rates" asp-route-cycleId="@Model.Cycle.Id">← Back to rates</a>}</div>
<div class="review-layout"><main><section class="review-kpis"><div><span>Total operating cost</span><strong>@totalCost.ToString("C")</strong></div><div><span>Forecast platform revenue</span><strong>@revenue.ToString("C")</strong></div><div class="@(revenue-totalCost>=0?"positive-kpi":"negative-kpi")"><span>Forecast balance</span><strong>@((revenue-totalCost).ToString("C"))</strong></div></section>
<article class="review-card"><div class="review-card-heading"><h2>Capability rates</h2><span>GST exclusive</span></div><div class="review-table-wrap"><table class="review-table"><thead><tr><th>Capability</th><th>Operating cost</th><th>Forecast use</th><th>UWA proposed</th><th>APFR proposed</th><th>Commercial proposed</th><th>Balance</th></tr></thead><tbody>@foreach(var c in Model.Cycle.Capabilities){var r=Model.Results[c.Id];<tr><td><strong>@c.Name</strong></td><td>@r.TotalOperatingCost.ToString("C")</td><td>@((c.ForecastUwaUse+c.ForecastApfrUse+c.ForecastCommercialUse).ToString("N1"))</td><td>@c.ProposedUwaRate.ToString("C")</td><td>@c.ProposedApfrRate.ToString("C")</td><td>@c.ProposedCommercialRate.ToString("C")</td><td class="@(r.ForecastBalance>=0?"positive-text":"negative-text")">@r.ForecastBalance.ToString("C")</td></tr>}</tbody></table></div></article>
<article class="review-card"><div class="review-card-heading"><h2>Assumptions and evidence</h2></div><div class="review-notes"><div><span>Benchmarking</span><p>@(Model.Cycle.BenchmarkNotes??"Not recorded")</p></div><div><span>Pricing justification</span><p>@(Model.Cycle.PricingJustification??"Not recorded")</p></div></div></article></main>
<aside class="submit-panel"><span class="submit-icon">✓</span><h2>@(Model.Submitted?"Submitted for approval":"Ready to submit?")</h2>@if(Model.Submitted){<p>This record is read-only. Submitted @Model.Cycle.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt").</p><a href="/" class="secondary-action full-button">Return to dashboard</a>}else{<p>Submission locks the figures and sends the cycle to the delegated authority.</p><form method="post" asp-page-handler="Submit" asp-route-cycleId="@Model.Cycle.Id"><div asp-validation-summary="All" class="form-errors submit-errors"></div><label class="confirmation"><input type="checkbox" name="confirmAccuracy" value="true"><span>I confirm the costs, utilisation assumptions, proposed rates and evidence are complete and accurate.</span></label><button class="submit-button" type="submit">Submit for approval <span>→</span></button></form>}</aside></div></div>

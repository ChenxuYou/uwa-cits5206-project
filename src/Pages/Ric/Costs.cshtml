@page
@model CostingTool.Pages.Ric.CostsModel
@{ViewData["Title"]="Detailed costs";var costs=Model.Cycle.Costs.Where(x=>x.CostType!="Non-variable income").Sum(x=>x.Amount);var income=Model.Cycle.Costs.Where(x=>x.CostType=="Non-variable income").Sum(x=>x.Amount);}
<div class="page-wrap ric-page"><partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(2,Model.Cycle.Id)' />
<div class="ric-title"><div><span class="eyebrow">@Model.Cycle.PlatformName.ToUpper() · DETAILED COST ENTRY</span><h1>Add detailed cost items</h1><p>Record each Personnel, Equipment, Maintenance, Travel, Animal Cost or Other item separately.</p></div><div class="ric-total"><small>Average annual amount to recover</small><strong>@((costs-income).ToString("C"))</strong></div></div>
<div class="ric-two-column detailed-cost-layout"><form method="post" asp-page-handler="Add" class="ric-card"><input type="hidden" asp-for="CycleId"><div class="ric-card-title"><h2>Add cost item</h2><p>Amounts are GST exclusive. Detailed values are retained for audit.</p></div><div asp-validation-summary="All" class="form-errors"></div>
<div class="form-grid two-columns"><label class="field"><span>Entry kind</span><select asp-for="EntryKind" id="entryKind"><option value="Cost">Operating cost</option><option value="Income">Non-variable income</option></select></label><label class="field"><span>Scope</span><select asp-for="Scope" id="scope"><option>Capability</option><option>Platform</option></select></label><label class="field full-span" id="capabilityField"><span>Capability</span><select asp-for="CapabilityId"><option value="">Select capability</option>@foreach(var c in Model.Cycle.Capabilities){<option value="@c.Id">@c.Name</option>}</select></label><label class="field full-span"><span>Category</span><select asp-for="Category" id="category"><option value="">Select category</option></select></label></div>
<section id="personnelPanel" class="detail-panel" hidden><h3>Personnel details</h3><div class="form-grid two-columns"><label class="field full-span"><span>Name *</span><input asp-for="PersonnelName"></label><label class="field"><span>Funding Type *</span><select asp-for="FundingType" id="fundingType"><option value="">Select</option><option>ARC Fellow</option><option>ARC Funded Position</option><option>Chief Investigator – UWA funded</option></select></label><label class="field" id="fellowshipField" hidden><span>Fellowship Type *</span><select asp-for="FellowshipType" id="fellowshipType"><option value="">Select</option><option>DECRA</option><option>DIA</option><option>FT</option></select></label><label class="field"><span>Step/Option</span><select asp-for="StepOption"><option>100% option</option><option>75% option</option><option>50% option</option></select></label><label class="field"><span>Work Years</span><select asp-for="WorkYears">@for(var y=1;y<=Model.YearCount;y++){<option>@y</option>}</select></label><label class="field"><span>Employment Type</span><select asp-for="EmploymentType"><option>Ongoing</option><option>Fixed Term</option><option>Casual</option></select></label><label class="field"><span>Percent Worked</span><select asp-for="PercentWorked"><option value="100">100%</option><option value="80">80%</option><option value="60">60%</option><option value="50">50%</option><option value="20">20%</option></select></label><label class="field"><span>Superannuation</span><select asp-for="SuperannuationPercent"><option value="17">17%</option><option value="12">12%</option><option value="0">0%</option></select></label><label class="field"><span>Staff Type</span><select asp-for="StaffType"><option>Academic</option><option>Professional</option></select></label><label class="field"><span>Salary Scale</span><select asp-for="SalaryScale"><option>LVLA</option><option>LVLB</option><option>LVLC</option><option>LVLD</option><option>LVLE</option></select></label><label class="field"><span>Salary Step</span><select asp-for="SalaryStep"><option>01</option><option>02</option><option>03</option><option>04</option><option>05</option></select></label><label class="field"><span>School Type</span><select asp-for="SchoolType"><option>Low cost school</option><option>High cost school</option></select></label><label class="field readonly-field"><span>Base Salary</span><input asp-for="BaseSalary" readonly></label></div></section>
<section id="genericPanel" class="detail-panel" hidden><h3>Item details</h3><div class="form-grid two-columns"><label class="field full-span"><span>Description *</span><input asp-for="Description" placeholder="Describe this cost item"></label><label class="field full-span"><span>Supplier / source</span><input asp-for="Supplier"></label></div></section>
<section id="yearsPanel" class="detail-panel" hidden><h3>Cost by year</h3><div class="year-grid">@for(var i=0;i<Model.YearCount;i++){<label class="field money-field"><span>@(Model.Cycle.StartYear+i)</span><div><b>$</b><input name="YearAmounts[@i]" type="number" min="0" step="0.01" value="0"></div></label>}</div></section><label class="field"><span>Notes / assumptions</span><textarea asp-for="Notes" rows="3"></textarea></label><button class="primary-button full-button add-detail-button" type="submit">＋ Add cost item</button></form>
<section class="ric-card"><div class="ric-card-title"><h2>Recorded items</h2><p>@Model.Cycle.Costs.Count detailed record(s)</p></div>@if(Model.Cycle.Costs.Count==0){<div class="empty-state">No cost items recorded yet.</div>}@foreach(var item in Model.Cycle.Costs.OrderByDescending(x=>x.Id)){<div class="cost-row detailed-row"><div><strong>@item.Description</strong><small>@item.Category · @(item.Capability?.Name??"Platform")</small><em>@string.Join(" · ",item.YearAmounts.OrderBy(x=>x.ProjectYear).Select((x,i)=>$"{Model.Cycle.StartYear+i}: {x.Amount:C0}"))</em></div><b>@item.Amount.ToString("C")<small>annual avg.</small></b><form method="post" asp-page-handler="Delete"><input type="hidden" name="CycleId" value="@Model.Cycle.Id"><input type="hidden" name="id" value="@item.Id"><button type="submit">×</button></form></div>}<div class="cost-summary"><span>Average annual costs <b>@costs.ToString("C")</b></span><span>Average annual income <b>−@income.ToString("C")</b></span><span>Amount to recover <b>@((costs-income).ToString("C"))</b></span></div></section></div>
<div class="wizard-actions"><a href="/" class="secondary-action">Save & exit</a><a class="primary-button" asp-page="/Ric/Capacity" asp-route-cycleId="@Model.Cycle.Id">Continue to capacity →</a></div></div>
@section Scripts{<script>
const entry=document.getElementById('entryKind'),category=document.getElementById('category'),scope=document.getElementById('scope'),cap=document.getElementById('capabilityField'),personnel=document.getElementById('personnelPanel'),generic=document.getElementById('genericPanel'),years=document.getElementById('yearsPanel'),funding=document.getElementById('fundingType'),fellow=document.getElementById('fellowshipField'),fellowSelect=document.getElementById('fellowshipType');const costs=['Personnel','Equipment','Maintenance','Travel','Animal Cost','Other'],incomes=['UWA GP / in-kind','State','Federal (incl. NCRIS)','Other recurrent support'];function enabled(panel,on){panel.querySelectorAll('input,select,textarea').forEach(x=>x.disabled=!on)}function update(){const previous=category.value;const values=entry.value==='Cost'?costs:incomes;category.innerHTML=values.map(x=>`<option>${x}</option>`).join('');category.value=values.includes(previous)?previous:values[0];if(entry.value==='Income'){scope.value='Platform'}cap.hidden=scope.value!=='Capability';detail()}function detail(){const selected=category.value,isPersonnel=selected==='Personnel';personnel.hidden=!isPersonnel;generic.hidden=!selected||isPersonnel;years.hidden=!selected;enabled(personnel,isPersonnel);enabled(generic,!!selected&&!isPersonnel);enabled(years,!!selected);fellowship()}function fellowship(){const show=funding.value==='ARC Fellow';fellow.hidden=!show;fellowSelect.disabled=!show;if(!show)fellowSelect.value=''}entry.onchange=update;scope.onchange=()=>cap.hidden=scope.value!=='Capability';category.onchange=detail;funding.onchange=fellowship;update();
</script>}

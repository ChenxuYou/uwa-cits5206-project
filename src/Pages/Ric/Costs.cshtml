@page
@model CostingTool.Pages.Ric.CostsModel
@{
    ViewData["Title"] = "Detailed costs";
    var costs = Model.Cycle.Costs.Where(x => !x.IsIncome).Sum(x => x.Amount);
    var income = Model.Cycle.Costs.Where(x => x.IsIncome).Sum(x => x.Amount);

    // US-06: the arithmetic is shown with income split the way the formulas split it, so
    // a custodian can see that UWA money and non-UWA money do different things.
    var uwaIncome = Model.Cycle.Costs.Where(x => x.IsUwaIncome).Sum(x => x.Amount);
    var nonUwaIncome = income - uwaIncome;
}
<div class="page-wrap ric-page"><partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(2,Model.Cycle.Id)' />
<div class="ric-title"><div><span class="eyebrow">@Model.Cycle.PlatformName.ToUpper() · DETAILED COST ENTRY</span><h1>Add detailed cost items</h1><p>Record each Personnel, Equipment, Maintenance, Travel, Animal Cost or Other item separately.</p></div><div class="ric-total"><small>Average annual amount to recover</small><strong>@((costs-income).ToString("C"))</strong></div></div>
<div class="ric-two-column detailed-cost-layout"><form method="post" asp-page-handler="Add" class="ric-card"><input type="hidden" asp-for="CycleId"><div class="ric-card-title"><h2 id="formTitle">Add cost item</h2><p>Amounts are GST exclusive. Detailed values are retained for audit.</p></div><div asp-validation-summary="All" class="form-errors"></div>
<div class="form-grid two-columns"><label class="field"><span>Entry kind</span><select asp-for="EntryKind" id="entryKind"><option value="Cost">Operating cost</option><option value="Income">Non-variable income</option></select></label><label class="field"><span>Scope</span><select asp-for="Scope" id="scope"><option>Capability</option><option>Platform</option></select></label><label class="field full-span" id="capabilityField"><span>Capability</span><select asp-for="CapabilityId"><option value="">Select capability</option>@foreach(var c in Model.Cycle.Capabilities){<option value="@c.Id">@c.Name</option>}</select></label><label class="field full-span"><span>Category</span><select asp-for="Category" id="category"><option value="">Select category</option></select><small id="categoryHint" hidden></small></label></div>
@* US-06. Shown only while "Non-variable income" is selected. The line-to-rate table is
   rendered from CostEntry.IncomeCategories, the same list the engine split is derived
   from, so the explanation cannot disagree with the calculation. *@
<section id="incomeGuide" class="detail-panel income-guide" hidden>
    <h3>About non-variable income</h3>
    <p>Recurrent support that subsidises the platform: UWA GP funding and in-kind commitments, NCRIS operational funding, and other recurrent government or philanthropic support. It is taken off the operating cost before rates are worked out, so users are not charged for costs that are already paid for.</p>
    <div class="callout">
        <span>!</span>
        <div>
            <strong>User fees of any description are not entered here</strong>
            <p>User fees are what this tool calculates. Entering them as income would count the same money twice.</p>
        </div>
    </div>
    <table class="income-lines">
        <thead><tr><th>Income line</th><th>Effect on the rates</th></tr></thead>
        <tbody>
            @foreach (var line in CostEntry.IncomeCategories.All)
            {
                <tr><td>@line</td><td>@CostEntry.IncomeCategories.RatesReduced(line)</td></tr>
            }
            <tr><td colspan="2"><small>The Commercial rate is not reduced by any income.</small></td></tr>
        </tbody>
    </table>
    <p class="income-optional">No income? Leave this section out. Entering nothing is valid, because not every platform receives support.</p>
</section>
<section id="personnelPanel" class="detail-panel" hidden><h3>Personnel details</h3><div class="form-grid two-columns"><label class="field full-span"><span>Name *</span><input asp-for="PersonnelName"></label><label class="field"><span>Funding Type *</span><select asp-for="FundingType" id="fundingType"><option value="">Select</option><option>ARC Fellow</option><option>ARC Funded Position</option><option>Chief Investigator – UWA funded</option></select></label><label class="field" id="fellowshipField" hidden><span>Fellowship Type *</span><select asp-for="FellowshipType" id="fellowshipType"><option value="">Select</option><option>DECRA</option><option>DIA</option><option>FT</option></select></label><label class="field"><span>Step/Option</span><select asp-for="StepOption"><option>100% option</option><option>75% option</option><option>50% option</option></select></label><label class="field"><span>Work Years</span><select asp-for="WorkYears">@for(var y=1;y<=Model.YearCount;y++){<option>@y</option>}</select></label><label class="field"><span>Employment Type</span><select asp-for="EmploymentType"><option>Ongoing</option><option>Fixed Term</option><option>Casual</option></select></label><label class="field"><span>Percent Worked</span><select asp-for="PercentWorked"><option value="100">100%</option><option value="80">80%</option><option value="60">60%</option><option value="50">50%</option><option value="20">20%</option></select></label><label class="field"><span>Superannuation</span><select asp-for="SuperannuationPercent"><option value="17">17%</option><option value="12">12%</option><option value="0">0%</option></select></label><label class="field"><span>Staff Type</span><select asp-for="StaffType"><option>Academic</option><option>Professional</option></select></label><label class="field"><span>Salary Scale</span><select asp-for="SalaryScale"><option>LVLA</option><option>LVLB</option><option>LVLC</option><option>LVLD</option><option>LVLE</option></select></label><label class="field"><span>Salary Step</span><select asp-for="SalaryStep"><option>01</option><option>02</option><option>03</option><option>04</option><option>05</option></select></label><label class="field"><span>School Type</span><select asp-for="SchoolType"><option>Low cost school</option><option>High cost school</option></select></label><label class="field readonly-field"><span>Base Salary</span><input asp-for="BaseSalary" readonly></label></div></section>
<section id="genericPanel" class="detail-panel" hidden><h3 id="genericTitle">Item details</h3><div class="form-grid two-columns"><label class="field full-span"><span id="descriptionLabel">Description *</span><input asp-for="Description" id="description" placeholder="Describe this cost item"></label><label class="field full-span"><span id="supplierLabel">Supplier / source</span><input asp-for="Supplier" id="supplier"></label></div></section>
<section id="yearsPanel" class="detail-panel" hidden><h3 id="yearsTitle">Cost by year</h3><div class="year-grid">@for(var i=0;i<Model.YearCount;i++){<label class="field money-field"><span>@(Model.Cycle.StartYear+i)</span><div><b>$</b><input name="YearAmounts[@i]" type="number" min="0" step="0.01" value="0"></div></label>}</div></section><label class="field"><span id="notesLabel">Notes / assumptions</span><textarea asp-for="Notes" id="notes" rows="3"></textarea><small id="notesHint" hidden>For example: NCRIS operational funding under the current funding agreement, committed until 30 June 2028.</small></label><button id="addButton" class="primary-button full-button add-detail-button" type="submit">＋ Add cost item</button></form>
<section class="ric-card"><div class="ric-card-title"><h2>Recorded items</h2><p>@Model.Cycle.Costs.Count detailed record(s)</p></div>@if(Model.Cycle.Costs.Count==0){<div class="empty-state">No cost items recorded yet.</div>}@foreach(var item in Model.Cycle.Costs.OrderByDescending(x=>x.Id)){<div class="cost-row detailed-row"><div><strong>@item.Description</strong><small>@item.Category · @(item.Capability?.Name??"Platform")@(item.IsIncome ? $" · {CostEntry.IncomeCategories.RatesReduced(item.Category)}" : "")</small><em>@string.Join(" · ",item.YearAmounts.OrderBy(x=>x.ProjectYear).Select((x,i)=>$"{Model.Cycle.StartYear+i}: {x.Amount:C0}"))</em></div><b>@(item.IsIncome ? "−" : "")@item.Amount.ToString("C")<small>annual avg.</small></b><form method="post" asp-page-handler="Delete"><input type="hidden" name="CycleId" value="@Model.Cycle.Id"><input type="hidden" name="id" value="@item.Id"><button type="submit">×</button></form></div>}<div class="cost-summary">
    <span><em>Total operating cost</em><b>@costs.ToString("C")</b></span>
    <span><em>Less UWA income<small>@CostEntry.IncomeCategories.RatesReduced(CostEntry.IncomeCategories.UwaGpInKind)</small></em><b>−@uwaIncome.ToString("C")</b></span>
    <span><em>Less non-UWA income<small>@CostEntry.IncomeCategories.RatesReduced(CostEntry.IncomeCategories.State)</small></em><b>−@nonUwaIncome.ToString("C")</b></span>
    <span><em>Amount to recover in user fees</em><b>@((costs-income).ToString("C"))</b></span>
</div>
@if (income == 0)
{
    <p class="income-optional">No non-variable income recorded. That is valid: not every platform receives support.</p>
}
</section></div>
<div class="wizard-actions"><a href="/" class="secondary-action">Save & exit</a><a class="primary-button" asp-page="/Ric/Capacity" asp-route-cycleId="@Model.Cycle.Id">Continue to capacity →</a></div></div>
@section Scripts{<script>
const entry=document.getElementById('entryKind'),category=document.getElementById('category'),scope=document.getElementById('scope'),cap=document.getElementById('capabilityField'),personnel=document.getElementById('personnelPanel'),generic=document.getElementById('genericPanel'),years=document.getElementById('yearsPanel'),funding=document.getElementById('fundingType'),fellow=document.getElementById('fellowshipField'),fellowSelect=document.getElementById('fellowshipType');// The two category lists come from CostEntry in Models/RicCycle.cs, so the dropdown, the
// server-side validation and the engine's income split cannot drift apart. They used to be
// typed out again here, one rename away from a silently mis-classified income line.
const costs=@Json.Serialize(CostEntry.CostCategories.All),incomes=@Json.Serialize(CostEntry.IncomeCategories.All);
// US-06. What each income line lowers, in the same order as `incomes`, from the same helper
// the recorded-items list and the summary use.
const incomeHints=@Json.Serialize(CostEntry.IncomeCategories.All.Select(x => CostEntry.IncomeCategories.RatesReduced(x)));
const text=(id,value)=>document.getElementById(id).textContent=value;
function labels(isIncome){
    document.getElementById('incomeGuide').hidden=!isIncome;
    document.getElementById('notesHint').hidden=!isIncome;
    text('formTitle',isIncome?'Add income line':'Add cost item');
    text('genericTitle',isIncome?'Income details':'Item details');
    text('descriptionLabel',isIncome?'Income line name *':'Description *');
    text('supplierLabel',isIncome?'Funding body':'Supplier / source');
    text('yearsTitle',isIncome?'Income by year':'Cost by year');
    text('notesLabel',isIncome?'Justification: where does this income come from, and how long is it committed for? *':'Notes / assumptions');
    text('addButton',isIncome?'＋ Add income line':'＋ Add cost item');
    document.getElementById('description').placeholder=isIncome?'e.g. NCRIS operational funding':'Describe this cost item';
}
function enabled(panel,on){panel.querySelectorAll('input,select,textarea').forEach(x=>x.disabled=!on)}function update(){const previous=category.value;const values=entry.value==='Cost'?costs:incomes;category.innerHTML=values.map(x=>`<option>${x}</option>`).join('');category.value=values.includes(previous)?previous:values[0];if(entry.value==='Income'){scope.value='Platform'}labels(entry.value==='Income');cap.hidden=scope.value!=='Capability';detail()}function detail(){const selected=category.value,isPersonnel=selected==='Personnel',hint=document.getElementById('categoryHint'),i=entry.value==='Income'?incomes.indexOf(selected):-1;hint.textContent=i>=0?incomeHints[i]:'';hint.hidden=i<0;personnel.hidden=!isPersonnel;generic.hidden=!selected||isPersonnel;years.hidden=!selected;enabled(personnel,isPersonnel);enabled(generic,!!selected&&!isPersonnel);enabled(years,!!selected);fellowship()}function fellowship(){const show=funding.value==='ARC Fellow';fellow.hidden=!show;fellowSelect.disabled=!show;if(!show)fellowSelect.value=''}entry.onchange=update;scope.onchange=()=>cap.hidden=scope.value!=='Capability';category.onchange=detail;funding.onchange=fellowship;update();
</script>}

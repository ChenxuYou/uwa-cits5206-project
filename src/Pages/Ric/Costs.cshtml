@page
@model CostingTool.Pages.Ric.CostsModel
@{
    ViewData["Title"] = "Detailed costs";
    var costItems = Model.Cycle.Costs.Where(x => !x.IsIncome).OrderByDescending(x => x.Id).ToList();
    var costs = Model.Costs;
    var isEditing = Model.EditId is not null;
    var totalCost = costs.Total;
    var ways = costs.Divisor;
    var categoryGroups = new (string Scope, string Heading, IReadOnlyList<string> Categories)[]
    {
        (CostEntry.Scopes.Capability, "Directly incurred by the capability", CostEntry.CostCategories.DirectlyIncurred),
        (CostEntry.Scopes.Platform, "Directly allocated from the platform", CostEntry.CostCategories.DirectlyAllocated),
        (CostEntry.Scopes.Platform, "Indirect — floor area", CostEntry.CostCategories.Indirect)
    };
}

<div class="page-wrap ric-page">
    <partial name="_RicSteps" model='new CostingTool.Pages.Ric.RicStepViewModel(2, Model.Cycle.Id)' />

    <div class="ric-title">
        <div>
            <span class="eyebrow">@Model.Cycle.PlatformName.ToUpper() · DETAILED COST ENTRY</span>
            <h1>Add operating cost items</h1>
            <p>Enter what each capability costs to run by the client's categories, and the platform's shared and floor-area costs once. Funding is entered separately in the next step.</p>
        </div>
        <div class="ric-total">
            <small>Platform operating cost, average per year</small>
            <strong>@totalCost.ToString("C")</strong>
        </div>
    </div>

    <div class="ric-two-column detailed-cost-layout">
        @* One form for adding and for changing a line (US-10). It names its action, so a
           refused save posts back to the same handler rather than to whatever the address
           bar last held. *@
        <form method="post" asp-page="/Ric/Costs" asp-page-handler="@(isEditing ? "Update" : "Add")" asp-route-cycleId="@Model.Cycle.Id" class="ric-card@(isEditing ? " editing-card" : "")" id="costForm" data-unsaved-warning>
            <input type="hidden" asp-for="CycleId" />
            @if (isEditing)
            {
                <input type="hidden" asp-for="EditId" />
                <div class="ric-card-title"><h2>Change cost item</h2><p>Saving replaces this line's figures. Amounts are GST exclusive.</p></div>
            }
            else
            {
                <div class="ric-card-title"><h2>Add cost item</h2><p>Amounts are GST exclusive. Detailed values are retained for audit.</p></div>
            }
            <div asp-validation-summary="All" class="form-errors"></div>

            <div class="form-grid two-columns">
                <label class="field">
                    <span>Scope</span>
                    <select asp-for="Scope" id="scope"><option>Capability</option><option>Platform</option></select>
                </label>
                <label class="field" id="capabilityField">
                    <span>Capability</span>
                    <select asp-for="CapabilityId">
                        <option value="">Select capability</option>
                        @foreach (var capability in Model.Cycle.Capabilities)
                        {
                            <option value="@capability.Id">@capability.Name</option>
                        }
                    </select>
                </label>
                <label class="field full-span">
                    <span>Cost category</span>
                    @* Written by hand rather than with asp-for: the same category name appears
                       under both scopes ("Materials and supplies"), and the tag helper would
                       mark both copies selected. The script shows only the current scope's. *@
                    <select name="Category" id="category">
                        @foreach (var group in categoryGroups)
                        {
                            <optgroup label="@group.Heading" data-scope="@group.Scope">
                                @foreach (var category in group.Categories)
                                {
                                    <option value="@category" selected="@(Model.Scope == group.Scope && Model.Category == category)">@category</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <small id="categoryHint"></small>
                </label>
            </div>

            <section id="personnelPanel" class="detail-panel" hidden>
                <h3>Personnel details</h3>
                <div class="form-grid two-columns">
                    <label class="field full-span"><span>Name *</span><input asp-for="PersonnelName" /></label>
                    <label class="field full-span" id="positionField">
                        <span>Position *</span>
                        <select asp-for="Position" id="position">
                            <option value="">Select</option>
                            @foreach (var position in CostEntry.Positions.All)
                            {
                                <option value="@position">@position</option>
                            }
                        </select>
                        <small>The workbook costs a capability's staff under these two roles. The platform leader's share of platform work goes under the platform-level "Platform leader salary and on-costs".</small>
                    </label>
                    <label class="field"><span>Position funding type *</span><select asp-for="FundingType" id="fundingType">
                        <option value="">Select</option>
                        @foreach (var fundingType in CostEntry.FundingTypes.All)
                        {
                            <option value="@fundingType">@fundingType</option>
                        }
                    </select></label>
                    <label class="field" id="fellowshipField" hidden><span>Fellowship Type *</span><select asp-for="FellowshipType" id="fellowshipType"><option value="">Select</option><option>DECRA</option><option>DIA</option><option>FT</option></select></label>
                    <label class="field"><span>Step/Option</span><select asp-for="StepOption"><option>100% option</option><option>75% option</option><option>50% option</option></select></label>
                    <label class="field">
                        <span>Work Years</span>
                        <select asp-for="WorkYears">
                            @for (var year = 1; year <= Model.YearCount; year++)
                            {
                                <option>@year</option>
                            }
                        </select>
                    </label>
                    <label class="field"><span>Employment Type</span><select asp-for="EmploymentType"><option>Ongoing</option><option>Fixed Term</option><option>Casual</option></select></label>
                    <label class="field"><span>Percent Worked</span><select asp-for="PercentWorked"><option value="100">100%</option><option value="80">80%</option><option value="60">60%</option><option value="50">50%</option><option value="20">20%</option></select></label>
                    <label class="field"><span>Superannuation</span><select asp-for="SuperannuationPercent"><option value="17">17%</option><option value="12">12%</option><option value="0">0%</option></select></label>
                    <label class="field"><span>Staff Type</span>
                        <select asp-for="StaffType" id="staffType">
                            @foreach (var staffType in CostEntry.SalaryScales.StaffTypes)
                            {
                                <option value="@staffType">@staffType</option>
                            }
                        </select>
                    </label>
                    @* Academic Levels A–E and professional Levels 1–10; the script shows only the
                       group for the chosen staff type, and the server checks the pair. *@
                    <label class="field"><span>Salary Level</span>
                        <select asp-for="SalaryScale" id="salaryScale">
                            <optgroup label="Academic" data-staff="@CostEntry.SalaryScales.Academic">
                                @foreach (var level in CostEntry.SalaryScales.AcademicLevels)
                                {
                                    <option value="@level.Code">@level.Label</option>
                                }
                            </optgroup>
                            <optgroup label="Professional" data-staff="@CostEntry.SalaryScales.Professional">
                                @foreach (var level in CostEntry.SalaryScales.ProfessionalLevels)
                                {
                                    <option value="@level.Code">@level.Label</option>
                                }
                            </optgroup>
                        </select>
                    </label>
                    <label class="field"><span>Salary Step</span><select asp-for="SalaryStep"><option>01</option><option>02</option><option>03</option><option>04</option><option>05</option></select></label>
                    @* The custodian enters the salary: the pay scales that would fill it in from the
                       level and step are US-05, not built. The yearly increase only feeds the fill
                       below and is not saved; the year amounts it produces are. *@
                    <label class="field money-field"><span>Base salary (full-time, per year)</span><div><b>$</b><input asp-for="BaseSalary" id="baseSalary" type="number" min="0" step="0.01" /></div><small>Optional. Enter it to fill each year's amount below.</small></label>
                    <label class="field"><span>Yearly salary increase (%)</span><input id="salaryIncrease" type="number" min="0" max="20" step="0.1" value="0" /><small>Applied from the second year. Not saved.</small></label>
                </div>
            </section>

            <section id="genericPanel" class="detail-panel" hidden>
                <h3>Item details</h3>
                <div class="form-grid two-columns">
                    <label class="field full-span"><span>Description *</span><input asp-for="Description" placeholder="Describe this cost item" /></label>
                    <label class="field full-span"><span>Supplier / source</span><input asp-for="Supplier" /></label>
                </div>
            </section>

            <section id="floorAreaPanel" class="detail-panel" hidden>
                <h3>Floor area</h3>
                <p class="panel-note">Indirect cost: the space the platform occupies, at the University's rate per m² per year. It is the same each year of the cycle.</p>
                <div class="form-grid two-columns">
                    <label class="field"><span>Floor area (m²) *</span><input asp-for="FloorArea" id="floorArea" type="number" min="0" step="0.01" /></label>
                    <label class="field money-field"><span>Rate per m² per year *</span><div><b>$</b><input asp-for="FloorAreaRate" id="floorAreaRate" type="number" min="0" step="0.01" /></div></label>
                    <label class="field full-span"><span>Location</span><input asp-for="Description" id="floorAreaDescription" placeholder="e.g. Level 2 laboratory, Bayliss Building" /></label>
                </div>
                <p class="panel-note" id="floorAreaResult" aria-live="polite"></p>
            </section>

            <section class="detail-panel" id="yearPanel">
                <h3>Cost by year</h3>
                <div id="salaryFill" hidden>
                    <p class="panel-note" id="salaryFillNote" aria-live="polite"></p>
                    <button type="button" class="secondary-action" id="salaryFillButton">Fill years from salary</button>
                </div>
                <div class="year-grid">
                    @for (var i = 0; i < Model.YearCount; i++)
                    {
                        <label class="field money-field"><span>@(Model.Cycle.StartYear + i)</span><div><b>$</b><input asp-for="YearAmounts[i]" type="number" min="0" step="0.01" /></div></label>
                    }
                </div>
            </section>

            <label class="field"><span>Notes / assumptions</span><textarea asp-for="Notes" rows="3"></textarea></label>
            @if (Model.NeedsLargeAmountConfirmation)
            {
                <label class="confirmation"><input type="checkbox" name="ConfirmLargeAmounts" value="true"><span>I have checked these amounts and they are correct.</span></label>
            }
            @if (isEditing)
            {
                <div class="edit-actions">
                    <a class="secondary-action" asp-page="/Ric/Costs" asp-route-cycleId="@Model.Cycle.Id">Cancel</a>
                    <button class="primary-button add-detail-button" type="submit">Save changes</button>
                </div>
            }
            else
            {
                <button class="primary-button full-button add-detail-button" type="submit">＋ Add cost item</button>
            }
        </form>

        <div class="cost-side">
        <section class="ric-card cost-rollup" aria-labelledby="rollup-heading">
            <div class="ric-card-title">
                <h2 id="rollup-heading">Running totals</h2>
                <p>Average per year. Each capability's own costs, and its share of the platform's.</p>
            </div>
            <div class="rollup-table-wrap" role="region" aria-label="Running totals by capability" tabindex="0">
                <table class="rollup-table">
                    <thead>
                        <tr>
                            <th scope="col">Capability</th>
                            <th scope="col">Directly incurred</th>
                            <th scope="col">Allocated from platform</th>
                            <th scope="col">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var capability in costs.Capabilities)
                        {
                            <tr>
                                <th scope="row">@capability.Name</th>
                                <td>@capability.DirectlyIncurred.ToString("C")</td>
                                <td>@capability.Allocated.ToString("C")</td>
                                <td>@capability.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">All capabilities</th>
                            <td>@costs.DirectlyIncurred.ToString("C")</td>
                            <td>@costs.PlatformLevel.ToString("C")</td>
                            <td>@costs.Capabilities.Sum(x => x.Total).ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="cost-summary">
                <span><em>Directly incurred by capabilities</em><b>@costs.DirectlyIncurred.ToString("C")</b></span>
                <span><em>Directly allocated at platform level</em><b>@costs.DirectlyAllocated.ToString("C")</b></span>
                <span><em>Indirect — floor area</em><b>@costs.Indirect.ToString("C")</b></span>
                <span><em>Platform operating cost</em><b>@totalCost.ToString("C")</b></span>
            </div>
            @if (costs.Reconciles)
            {
                <p class="rollup-check">✓ The capability totals add up to the platform operating cost.</p>
            }
            else if (ways > 0)
            {
                <p class="rollup-check rollup-check-fail" role="alert">The capability totals do not add up to the platform operating cost. Report this: the figures are being summed over different lines.</p>
            }

            @* US-04: say plainly how a platform-level cost reaches a capability, including where
               this tool departs from the workbook, rather than leaving it to be discovered. *@
            <details class="rollup-rule" open="@(costs.PlatformLevel > 0 ? "open" : null)">
                <summary>How platform-level costs reach each capability</summary>
                <p>
                    Every platform-level line — directly allocated or indirect — is split evenly across the
                    @ways @(ways == 1 ? "capability" : "capabilities") in this cycle, so each carries
                    @(ways > 0 ? $"one {(ways == 1 ? "whole" : OrdinalShare(ways))}" : "none") of it:
                    <strong>@costs.AllocatedToEach.ToString("C")</strong> each at the moment. It is shown against each
                    capability as allocated, never as a cost the capability incurred itself.
                </p>
                <p>
                    The client's workbook divides administration costs and the platform leader's salary across one
                    more column — Analysis/Consulting — than its other platform-level rows. This tool uses the same
                    divisor for every category: if Analysis/Consulting is costed here, add it as a capability and it
                    takes an equal share of every platform-level line.
                </p>
            </details>
        </section>

        <section class="ric-card">
            <div class="ric-card-title"><h2>Recorded costs</h2><p>@costItems.Count operating cost record(s)</p></div>
            @if (costItems.Count == 0)
            {
                <div class="empty-state">No operating costs recorded yet.</div>
            }
            @foreach (var item in costItems)
            {
                <div class="cost-row detailed-row editable-row@(item.Id == Model.EditId ? " is-editing" : "")">
                    <div>
                        <strong>@item.Description</strong>
                        <small>@CostEntry.CostCategories.ClassOf(item.Scope, item.Category) · @item.Category@(item.Position is null ? "" : $" ({item.Position})") · @(item.Capability?.Name ?? $"Platform, split {ways} ways")</small>
                        @if (item.FloorArea is not null)
                        {
                            <em>@item.FloorArea.Value.ToString("N1") m² × @item.FloorAreaRate?.ToString("C") per m² per year</em>
                        }
                        else
                        {
                            <em>@string.Join(" · ", item.YearAmounts.OrderBy(x => x.ProjectYear).Select((x, i) => $"{Model.Cycle.StartYear + i}: {x.Amount:C0}"))</em>
                        }
                    </div>
                    <b>@item.Amount.ToString("C")<small>annual avg.</small></b>
                    <a class="row-edit" asp-page="/Ric/Costs" asp-route-cycleId="@Model.Cycle.Id" asp-route-edit="@item.Id" aria-label="Change @item.Description">Edit</a>
                    <form method="post" asp-page-handler="Delete"><input type="hidden" name="CycleId" value="@Model.Cycle.Id" /><input type="hidden" name="id" value="@item.Id" /><button type="submit" aria-label="Delete @item.Description">×</button></form>
                </div>
            }
        </section>
        </div>
    </div>

    @* US-13: room to explain the costs section as a whole, not only line by line, and the
       first item on the guide's Step 5 checklist. A form of its own, so saving it never
       submits a half-typed cost line. data-save-on-leave: typed assumptions are saved when
       the custodian leaves by any link, as on the capacity and rates steps (US-02). *@
    <form method="post" asp-page="/Ric/Costs" asp-page-handler="Assumptions" asp-route-cycleId="@Model.Cycle.Id" class="ric-card costing-assumptions" data-unsaved-warning data-save-on-leave="true">
        <input type="hidden" name="CycleId" value="@Model.Cycle.Id" />
        <input type="hidden" name="LeavingFor" value="" />
        <label class="field">
            <span>Costing assumptions</span>
            <small>What these figures rest on as a whole: which budget they come from, how salaries were estimated, what was treated as in-kind, and anything left out and why. The guide's Step 5 checklist asks for costing assumptions to be documented before approval. Each line keeps its own note as well.</small>
            <textarea asp-for="CostingAssumptions" rows="4" placeholder="e.g. 2026 budget as approved in March; salaries at the current EBA step plus 17% on-costs; the building is provided in kind and costed at the University's floor-area rate."></textarea>
        </label>
        <div class="assumptions-actions">
            <button class="outline-button" type="submit">Save costing assumptions</button>
            @if (TempData["CostsMessage"] is string saved)
            {
                <span class="rollup-check" role="status">✓ @saved</span>
            }
        </div>
    </form>

    <div class="wizard-actions"><a href="/" class="secondary-action">Save &amp; exit</a><a class="primary-button" asp-page="/Ric/Funding" asp-route-cycleId="@Model.Cycle.Id">Continue to funding sources →</a></div>
</div>

@functions {
    private static string OrdinalShare(int ways) => ways switch
    {
        2 => "half",
        3 => "third",
        4 => "quarter",
        _ => $"{ways}th"
    };
}

@section Scripts {
    <script>
        const personnelCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] { CostEntry.CostCategories.EmployeeSalaryAndOnCosts, CostEntry.CostCategories.PlatformLeaderSalary }));
        const floorAreaCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CostEntry.CostCategories.Indirect));
        const employeeCategory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CostEntry.CostCategories.EmployeeSalaryAndOnCosts));
        const category = document.getElementById('category');
        const scope = document.getElementById('scope');
        const capability = document.getElementById('capabilityField');
        const personnel = document.getElementById('personnelPanel');
        const generic = document.getElementById('genericPanel');
        const funding = document.getElementById('fundingType');
        const fellowship = document.getElementById('fellowshipField');
        const fellowshipSelect = document.getElementById('fellowshipType');
        const arcFellow = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CostEntry.FundingTypes.ArcFellow));
        const staffType = document.getElementById('staffType');
        const salaryScale = document.getElementById('salaryScale');

        const floorArea = document.getElementById('floorAreaPanel');
        const yearPanel = document.getElementById('yearPanel');
        const positionField = document.getElementById('positionField');
        const hint = document.getElementById('categoryHint');
        const money = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' });

        function setEnabled(panel, enabled) { panel.querySelectorAll('input, select, textarea').forEach(input => input.disabled = !enabled); }
        function updateCategory() {
            const isPersonnel = personnelCategories.includes(category.value);
            const isFloorArea = floorAreaCategories.includes(category.value);
            personnel.hidden = !isPersonnel; setEnabled(personnel, isPersonnel);
            floorArea.hidden = !isFloorArea; setEnabled(floorArea, isFloorArea);
            generic.hidden = isPersonnel || isFloorArea; setEnabled(generic, !isPersonnel && !isFloorArea);
            yearPanel.hidden = isFloorArea; setEnabled(yearPanel, !isFloorArea);
            const needsPosition = category.value === employeeCategory;
            positionField.hidden = !needsPosition; positionField.querySelector('select').disabled = !isPersonnel || !needsPosition;
            updateFellowship();
            updateFloorArea();
            updateSalaryFill();
        }
        // Only the current scope's categories can be chosen: a capability takes directly
        // incurred costs, the platform directly allocated and indirect ones.
        function updateScope() {
            const isCapability = scope.value === 'Capability';
            capability.hidden = !isCapability; capability.querySelector('select').disabled = !isCapability;
            let keep = false;
            category.querySelectorAll('optgroup').forEach(group => {
                const allowed = group.dataset.scope === scope.value;
                group.hidden = !allowed; group.disabled = !allowed;
                if (allowed && group.contains(category.selectedOptions[0])) keep = true;
            });
            if (!keep) {
                const first = category.querySelector(`optgroup[data-scope="${scope.value}"] option`);
                if (first) first.selected = true;
            }
            hint.textContent = isCapability
                ? 'Costs this capability incurs itself.'
                : 'Entered once for the platform and split evenly across every capability.';
            updateCategory();
        }
        function updateFloorArea() {
            const out = document.getElementById('floorAreaResult');
            const area = Number(document.getElementById('floorArea').value) || 0;
            const rate = Number(document.getElementById('floorAreaRate').value) || 0;
            out.textContent = area > 0 && rate > 0 ? `${area} m² × ${money.format(rate)} = ${money.format(Math.round(area * rate * 100) / 100)} per year` : '';
        }
        document.getElementById('floorArea').addEventListener('input', updateFloorArea);
        document.getElementById('floorAreaRate').addEventListener('input', updateFloorArea);
        function updateSalaryLevels() {
            // Show only the levels for the chosen staff type; keep the saved level if it fits.
            let keep = false;
            salaryScale.querySelectorAll('optgroup').forEach(group => {
                const allowed = group.dataset.staff === staffType.value;
                group.hidden = !allowed;
                group.querySelectorAll('option').forEach(option => option.disabled = !allowed);
                if (allowed && group.contains(salaryScale.selectedOptions[0])) keep = true;
            });
            if (!keep) {
                const first = salaryScale.querySelector(`optgroup[data-staff="${staffType.value}"] option`);
                if (first) salaryScale.value = first.value;
            }
        }
        // Each year the person works is base salary × percent worked × (1 + superannuation),
        // raised by the yearly increase from the second year; later years are nil. The form
        // fills the years while they hold nothing typed by hand, and the button refills them.
        const baseSalary = document.getElementById('baseSalary');
        const salaryIncrease = document.getElementById('salaryIncrease');
        const percentWorked = document.getElementById('PercentWorked');
        const superannuation = document.getElementById('SuperannuationPercent');
        const workYears = document.getElementById('WorkYears');
        const salaryFill = document.getElementById('salaryFill');
        const salaryFillNote = document.getElementById('salaryFillNote');
        const yearInputs = [...yearPanel.querySelectorAll('input[name^="YearAmounts"]')];
        let typedByHand = yearInputs.some(input => Number(input.value) > 0);

        function salaryByYear() {
            const base = Number(baseSalary.value);
            if (!(base > 0)) return null;
            const share = (Number(percentWorked.value) || 0) / 100;
            const onCost = 1 + (Number(superannuation.value) || 0) / 100;
            const rise = 1 + (Number(salaryIncrease.value) || 0) / 100;
            const years = Number(workYears.value) || 1;
            return yearInputs.map((_, i) => i < years ? Math.round(base * share * onCost * Math.pow(rise, i) * 100) / 100 : 0);
        }
        function fillYears() {
            const amounts = salaryByYear();
            if (!amounts) return;
            yearInputs.forEach((input, i) => input.value = amounts[i].toFixed(2));
            typedByHand = false;
            updateSalaryFill();
        }
        function updateSalaryFill() {
            const isPersonnel = personnelCategories.includes(category.value);
            salaryFill.hidden = !isPersonnel;
            if (!isPersonnel) return;
            const amounts = salaryByYear();
            if (!amounts) {
                salaryFillNote.textContent = 'Enter a base salary above to fill these from it, or type each year.';
            } else if (typedByHand) {
                salaryFillNote.textContent = 'These amounts were typed in or saved earlier. Fill years from salary to work them out again from the salary above.';
            } else {
                salaryFillNote.textContent = `Filled from the salary: ${money.format(Number(baseSalary.value))} × ${Number(percentWorked.value) || 0}% worked, plus ${Number(superannuation.value) || 0}% superannuation, for ${Number(workYears.value) || 1} year(s)${Number(salaryIncrease.value) > 0 ? `, rising ${Number(salaryIncrease.value)}% a year` : ''}. Change any year if needed; add other on-costs by hand.`;
            }
            document.getElementById('salaryFillButton').disabled = !amounts;
        }
        function salaryChanged() { if (!typedByHand) fillYears(); updateSalaryFill(); }
        [baseSalary, salaryIncrease].forEach(input => input.addEventListener('input', salaryChanged));
        [percentWorked, superannuation, workYears].forEach(input => input.addEventListener('change', salaryChanged));
        yearInputs.forEach(input => input.addEventListener('input', () => { typedByHand = true; updateSalaryFill(); }));
        document.getElementById('salaryFillButton').addEventListener('click', fillYears);

        function updateFellowship() { const visible = funding.value === arcFellow; fellowship.hidden = !visible; fellowshipSelect.disabled = !visible; if (!visible) fellowshipSelect.value = ''; }

        category.addEventListener('change', updateCategory);
        scope.addEventListener('change', updateScope);
        funding.addEventListener('change', updateFellowship);
        staffType.addEventListener('change', updateSalaryLevels);
        updateSalaryLevels();
        updateScope();
    </script>
}

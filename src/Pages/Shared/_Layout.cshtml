@inject CostingDbContext LayoutDb
@{
    var isCustodian = User.IsInRole(AppUser.Roles.DataEntry);
    var isApprover = User.IsInRole(AppUser.Roles.Approver);

    var unreadNotifications = User.Identity?.IsAuthenticated == true && isCustodian
        ? LayoutDb.AppNotifications.Count(x => x.RecipientUserName == User.UserName() && !x.IsRead)
        : 0;

    // The highlighted item follows the page being viewed. It used to be fixed on Overview,
    // so the sidebar said "you are here" in the wrong place on every screen but one.
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string NavClass(string prefix) =>
        prefix == "/"
            ? (path == "/" ? "nav-item active" : "nav-item")
            : (path.StartsWith(prefix) ? "nav-item active" : "nav-item");
}
<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · UWA Research Infrastructure</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@600;700;800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/" aria-label="UWA Research Infrastructure home">
                <span class="brand-mark">UWA</span>
                <span><strong>Research Infrastructure</strong><small>Costing &amp; Pricing</small></span>
            </a>

            <nav class="main-nav" aria-label="Main navigation">
                <a class="@NavClass("/")" href="/">
                    <span class="nav-icon" aria-hidden="true">⌂</span><span>Overview</span>
                </a>
                @if (isCustodian)
                {
                    <a class="@NavClass("/ric/start")" asp-page="/Ric/Start">
                        <span class="nav-icon" aria-hidden="true">◫</span><span>New costing cycle</span>
                    </a>
                    <a class="@NavClass("/notifications")" asp-page="/Notifications/Index">
                        <span class="nav-icon" aria-hidden="true">♢</span><span>Notifications</span>
                        @if (unreadNotifications > 0)
                        {
                            <span class="nav-count">@unreadNotifications</span>
                        }
                    </a>
                }
                @if (isApprover)
                {
                    <a class="@NavClass("/approvals")" asp-page="/Approvals/Index">
                        <span class="nav-icon" aria-hidden="true">✓</span><span>Approval queue</span>
                    </a>
                }
            </nav>

            @*
                The sidebar previously carried Capabilities, Reports, Settings and a "View
                guide" link, all pointing at "#". Placeholder navigation is worse than none
                in front of a client: it invites a click and answers with nothing. What is
                built is listed above; the rest returns when the pages exist.
            *@
            <div class="sidebar-help">
                <span class="help-icon" aria-hidden="true">?</span>
                <strong>Need help?</strong>
                <p>The method follows the UWA Costing &amp; Pricing Guide. Contact Research Infrastructure with anything the guide does not answer.</p>
            </div>
        </aside>

        <main class="main-content" id="main-content">
            <header class="topbar">
                <button class="menu-button" id="menuButton" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">☰</button>
                <div class="topbar-spacer"></div>
                @if (isCustodian)
                {
                    <a class="icon-button" asp-page="/Notifications/Index"
                       aria-label="@(unreadNotifications > 0 ? $"Notifications, {unreadNotifications} unread" : "Notifications")">
                        ♢@if (unreadNotifications > 0) { <span class="notification-dot"></span> }
                    </a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var displayName = User.DisplayName();
                    var initials = string.Concat(displayName
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2)
                        .Select(x => x[0]))
                        .ToUpperInvariant();

                    <div class="user-chip">
                        <span class="avatar" aria-hidden="true">@initials</span>
                        <span>
                            <strong>@displayName</strong>
                            <small>@(isApprover ? "Delegated approver" : "Platform custodian")</small>
                        </span>
                        <form method="post" asp-page="/Account/Logout">
                            <button class="logout-button" type="submit">Sign out</button>
                        </form>
                    </div>
                }
            </header>

            @RenderBody()
        </main>
    </div>

    <script>
        const menuButton = document.getElementById('menuButton');
        menuButton?.addEventListener('click', () => {
            const open = document.getElementById('sidebar')?.classList.toggle('open');
            menuButton.setAttribute('aria-expanded', String(!!open));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

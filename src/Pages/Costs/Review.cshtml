@page
@model CostingTool.Pages.Costs.ReviewModel
@{
    ViewData["Title"] = "Review costing cycle";
}

<div class="page-wrap review-page">
    <nav class="breadcrumb"><a href="/">Overview</a><span>›</span><a asp-page="/Costs/Create" asp-route-cycleId="@Model.Cycle.Id">Cost entry</a><span>›</span><span>Review</span></nav>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="submit-success"><span>✓</span><div><strong>Submitted successfully</strong><p>@Model.SuccessMessage The record is now read-only.</p></div></div>
    }

    <section class="review-heading">
        <div>
            <span class="status-pill @(Model.Submitted ? "sealed" : "draft")">@Model.Cycle.Status</span>
            <h1>Review project costing</h1>
            <p>Check the project information and all cost items before submitting.</p>
        </div>
        @if (!Model.Submitted)
        {
            <a class="outline-action" asp-page="/Costs/Create" asp-route-cycleId="@Model.Cycle.Id">← Back to edit</a>
        }
    </section>

    <div class="review-layout">
        <main>
            <article class="review-card">
                <div class="review-card-heading"><h2>Project details</h2><span>@Model.Cycle.DurationYears year project</span></div>
                <dl class="project-summary">
                    <div><dt>Project name</dt><dd>@Model.Cycle.ProjectName</dd></div>
                    <div><dt>Project reference</dt><dd>@(Model.Cycle.ProjectReference ?? "Not provided")</dd></div>
                    <div><dt>Start year</dt><dd>@Model.Cycle.StartYear</dd></div>
                    <div><dt>Costing period</dt><dd>@Model.Cycle.StartYear–@(Model.Cycle.StartYear + Model.Cycle.DurationYears - 1)</dd></div>
                </dl>
            </article>

            <article class="review-card">
                <div class="review-card-heading"><div><h2>Cost items</h2><p>@Model.Cycle.CostItems.Count item(s) included</p></div></div>
                <div class="review-table-wrap">
                    <table class="review-table">
                        <thead><tr><th>Item</th><th>Category</th>@for (var year = 1; year <= Model.Cycle.DurationYears; year++) { <th>Year @year</th> }<th>Total</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Cycle.CostItems)
                        {
                            <tr>
                                <td><strong>@(item.PersonnelName ?? item.Description)</strong>@if (item.Category == "personnel") { <small>@item.EmploymentType · @item.PercentWorked%</small> }</td>
                                <td><span class="category-chip">@item.Category</span></td>
                                @for (var year = 1; year <= Model.Cycle.DurationYears; year++)
                                {
                                    var amount = item.YearAmounts.FirstOrDefault(x => x.ProjectYear == year)?.Amount ?? 0;
                                    <td>@amount.ToString("C")</td>
                                }
                                <td><strong>@item.YearAmounts.Sum(x => x.Amount).ToString("C")</strong></td>
                            </tr>
                        }
                        </tbody>
                        <tfoot><tr><td colspan="2">Project total</td>@for (var year = 1; year <= Model.Cycle.DurationYears; year++) { var total = Model.Cycle.CostItems.SelectMany(x => x.YearAmounts).Where(x => x.ProjectYear == year).Sum(x => x.Amount); <td>@total.ToString("C")</td> }<td>@Model.GrandTotal.ToString("C")</td></tr></tfoot>
                    </table>
                </div>
            </article>
        </main>

        <aside class="submit-panel">
            <span class="submit-icon">✓</span>
            <h2>@(Model.Submitted ? "Costing submitted" : "Ready to submit?")</h2>
            @if (Model.Submitted)
            {
                <p>This costing cycle was submitted on @Model.Cycle.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt"). It can no longer be edited.</p>
                <dl class="submission-meta"><div><dt>Status</dt><dd>Submitted</dd></div><div><dt>Submitted by</dt><dd>Priya Lal</dd></div></dl>
                <a class="secondary-action full-button" href="/">Return to dashboard</a>
            }
            else
            {
                <p>Submitting locks this costing cycle for review. You will no longer be able to edit its costs.</p>
                <form method="post" asp-page-handler="Submit" asp-route-cycleId="@Model.Cycle.Id">
                    <div asp-validation-summary="All" class="form-errors submit-errors"></div>
                    <label class="confirmation"><input type="checkbox" name="confirmAccuracy" value="true"><span>I confirm that the project information and cost figures are complete and accurate.</span></label>
                    <button class="submit-button" type="submit">Submit costing cycle <span>→</span></button>
                </form>
                <small>After submitting, contact an administrator if corrections are required.</small>
            }
        </aside>
    </div>
</div>

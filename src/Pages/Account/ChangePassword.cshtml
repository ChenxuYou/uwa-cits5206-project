@page
@model CostingTool.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div class="page-wrap ric-page">
    <nav class="breadcrumb"><a href="/">Overview</a><span>›</span><span>Change password</span></nav>

    <form method="post" class="ric-card narrow-card">
        <div class="ric-heading">
            <span>◆</span>
            <div>
                <h1>Change password</h1>
                <p>Changing your password signs out other sessions that use your old credentials.</p>
            </div>
        </div>

        @if (User.MustChangePassword())
        {
            @* M4: the password was set by an administrator or from the server's configuration. *@
            <div class="callout" role="status"><span>!</span><div><strong>Choose your own password to continue</strong><p>Your password was set by someone else. Enter it below as the current password, then choose a new one. The rest of the tool opens once you have.</p></div></div>
        }
        <div asp-validation-summary="All" class="form-errors"></div>

        <div class="form-grid">
            <label class="field">
                <span>Current password *</span>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
            </label>
            <label class="field">
                <span>New password *</span>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                <small>@PasswordPolicy.Description</small>
            </label>
            <label class="field">
                <span>Confirm new password *</span>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            </label>
        </div>

        <div class="wizard-actions">
            <a class="secondary-action" href="/">Cancel</a>
            <button class="primary-button" type="submit">Update password</button>
        </div>
    </form>
</div>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      .NET 10 is new, and an unpinned dependency graph is a build that can break
      without a commit (risks.md R18). The lockfile is generated by the next
      `dotnet restore` and must then be committed; CI restores against it.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CostingTool.Engine\CostingTool.Engine.csproj" />
    <ProjectReference Include="CostingTool.Pdf\CostingTool.Pdf.csproj" />
  </ItemGroup>

  <!--
    Sibling projects live in folders underneath this one, and this project's SDK globs
    **/*.cs from its own directory. Without these Removes their source is compiled into
    BOTH assemblies — every type then exists twice and the compiler cannot tell which one
    a page means (CS0436) — and their generated AssemblyInfo is pulled in on top of ours
    (CS0579).

    The folders are listed one by one rather than globbed: a `CostingTool.*\**` pattern
    that silently fails to expand would produce CS0436 on every type in the project it
    was meant to exclude, and an explicit list cannot do that.

    THE WIDER FIX IS NOW OVERDUE. The comment that used to sit here said this workaround
    was "worth doing before a third project is added" — CostingTool.Pdf is that third
    project, so the debt is called in rather than paid again: moving the web application
    to `src/CostingTool.Web/`, beside its siblings rather than around them, removes this
    ItemGroup entirely. Tracked in plan.md §6, owned and dated, not left as a comment.
  -->
  <ItemGroup>
    <Compile Remove="CostingTool.Engine\**" />
    <Content Remove="CostingTool.Engine\**" />
    <EmbeddedResource Remove="CostingTool.Engine\**" />
    <None Remove="CostingTool.Engine\**" />

    <Compile Remove="CostingTool.Pdf\**" />
    <Content Remove="CostingTool.Pdf\**" />
    <EmbeddedResource Remove="CostingTool.Pdf\**" />
    <None Remove="CostingTool.Pdf\**" />
  </ItemGroup>

</Project>

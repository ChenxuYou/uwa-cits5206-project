<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      .NET 10 is new, and an unpinned dependency graph is a build that can break
      without a commit (risks.md R18). The lockfile is generated by the next
      `dotnet restore` and must then be committed; CI restores against it.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CostingTool.Engine\CostingTool.Engine.csproj" />
  </ItemGroup>

  <!--
    The engine project lives in a folder underneath this one, and this project's
    SDK globs **/*.cs from its own directory. Without these Removes the engine's
    source is compiled into BOTH assemblies — every engine type then exists twice
    and the compiler cannot tell which one a page means (CS0436) — and the engine's
    generated AssemblyInfo is pulled in on top of ours (CS0579).

    Excluding it here is the narrow fix. The wider one is to stop nesting a project
    inside another project's directory: `src/CostingTool.Web/` beside
    `src/CostingTool.Engine/` needs no Removes at all, because no project would
    contain another. Worth doing before a third project is added.
  -->
  <ItemGroup>
    <Compile Remove="CostingTool.Engine\**" />
    <Content Remove="CostingTool.Engine\**" />
    <EmbeddedResource Remove="CostingTool.Engine\**" />
    <None Remove="CostingTool.Engine\**" />
  </ItemGroup>

</Project>
